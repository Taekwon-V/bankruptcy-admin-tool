      "html": "<script data-asset-crawler=\"\">\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19248/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/bankruptcy-admin-tool.canvas\", nodeId: \"inspiration_node_7d44b5a34d8b\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><style>\n  :root{\n    /* palette shifted from vivid violet -> deep teal, lime -> warm amber */\n    --bg:#0e6b74;\n    --bg-2:#0c5f68;\n    --card:#ffffff;\n    --ink:#111417;\n    --accent:#0e6b74;      /* teal for card headings */\n    --amber:#ffc53d;       /* badge + check accent (was lime) */\n    --amber-ink:#3a2c00;\n    --muted:#9aa1a6;\n    --muted-on-dark:#c7d6d8;\n    --line:#e7e9eb;\n    --dark:#111417;\n    --radius:18px;\n    --font:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n  }\n  *{box-sizing:border-box;margin:0;padding:0}\n  html,body{background:var(--bg)}\n  body{\n    font-family:var(--font);\n    color:var(--ink);\n    -webkit-font-smoothing:antialiased;\n    padding:56px 40px 64px;\n  }\n  .wrap{max-width:1086px;margin:0 auto}\n\n  /* ---- header ---- */\n  .head{\n    display:flex;\n    align-items:flex-start;\n    justify-content:space-between;\n    gap:24px;\n    margin-bottom:40px;\n  }\n  .head h1{\n    color:#fff;\n    font-size:88px;\n    line-height:.92;\n    font-weight:800;\n    letter-spacing:-.03em;\n  }\n  .head p{\n    color:rgba(255,255,255,.82);\n    font-size:15px;\n    line-height:1.45;\n    text-align:right;\n    max-width:250px;\n    padding-top:14px;\n  }\n\n  /* ---- pricing grid ---- */\n  .grid{\n    display:grid;\n    grid-template-columns:repeat(3,1fr);\n    gap:22px;\n    margin-bottom:22px;\n  }\n  .card{\n    position:relative;\n    background:var(--card);\n    border-radius:var(--radius);\n    padding:28px 26px 26px;\n    display:flex;\n    flex-direction:column;\n  }\n  .card h2{\n    color:var(--accent);\n    font-size:21px;\n    font-weight:800;\n    letter-spacing:-.01em;\n    margin-bottom:12px;\n  }\n  .card .note{\n    color:var(--muted);\n    font-size:14px;\n    line-height:1.45;\n    margin-bottom:22px;\n  }\n  .price{\n    display:flex;\n    align-items:baseline;\n    gap:4px;\n    margin-bottom:22px;\n  }\n  .price .amt{\n    font-size:52px;\n    font-weight:800;\n    letter-spacing:-.03em;\n    line-height:1;\n  }\n  .price .per{\n    color:var(--ink);\n    font-size:16px;\n    font-weight:500;\n  }\n  .divider{height:1px;background:var(--line);margin-bottom:20px}\n  ul{list-style:none;display:flex;flex-direction:column;gap:12px;margin-bottom:28px}\n  li{display:flex;align-items:center;gap:10px;font-size:15px;color:#20262b}\n  .check{flex:0 0 auto}\n  .btn{\n    align-self:flex-start;\n    background:var(--dark);\n    color:#fff;\n    border:none;\n    border-radius:999px;\n    font-family:var(--font);\n    font-size:15px;\n    font-weight:500;\n    padding:13px 26px;\n    cursor:pointer;\n    margin-top:auto;\n  }\n  .badge{\n    position:absolute;\n    top:24px;\n    right:24px;\n    background:var(--amber);\n    color:var(--amber-ink);\n    font-size:12px;\n    font-weight:700;\n    padding:5px 11px;\n    border-radius:999px;\n  }\n\n  /* ---- bottom dark card ---- */\n  .banner{\n    background:var(--dark);\n    border-radius:var(--radius);\n    padding:30px 34px;\n    display:grid;\n    grid-template-columns:1fr auto;\n    align-items:center;\n    gap:24px;\n  }\n  .banner h2{color:var(--amber);font-size:20px;font-weight:800;margin-bottom:8px}\n  .banner .sub{color:#aeb6ba;font-size:14px;margin-bottom:22px}\n  .tools{display:flex;flex-wrap:wrap;gap:26px}\n  .tools span{display:flex;align-items:center;gap:9px;color:#fff;font-size:15px}\n  .banner-right{text-align:right}\n  .banner-price{display:flex;align-items:baseline;justify-content:flex-end;gap:4px;margin-bottom:18px}\n  .banner-price .amt{color:#fff;font-size:52px;font-weight:800;letter-spacing:-.03em;line-height:1}\n  .banner-price .per{color:#fff;font-size:16px;font-weight:500}\n  .btn-light{\n    background:#fff;color:var(--ink);border:none;border-radius:999px;\n    font-family:var(--font);font-size:15px;font-weight:500;padding:13px 26px;cursor:pointer;\n  }\n\n  /* ---- responsive ---- */\n  @media(max-width:880px){\n    body{padding:40px 22px 48px}\n    .head{flex-direction:column;gap:16px}\n    .head h1{font-size:60px}\n    .head p{text-align:left;padding-top:0}\n    .grid{grid-template-columns:1fr;gap:18px}\n    .banner{grid-template-columns:1fr;gap:26px}\n    .banner-right{text-align:left}\n    .banner-price{justify-content:flex-start}\n  }\n</style>\n\n<div class=\"wrap\" data-kid=\"ktbrl4q\">\n\n  <header class=\"head\" data-kid=\"kl84xkz\">\n    <h1 data-kid=\"k6ga9f6\">사건 탐색기</h1>\n    \n  </header>\n\n  <section class=\"grid\" data-kid=\"kd2juk5\">\n\n    <!-- Flex -->\n    <article class=\"card\" data-kid=\"kl4o9b6\">\n      <h2 data-kid=\"kgv5e8i\" style=\"font-size: 25px;\">2026하단0209</h2><span class=\"badge\" data-kid=\"keslfak\" style=\"font-size: 16px;\">조사.보정</span>\n      \n      <div class=\"price\" data-kid=\"kaorvh0\"><span class=\"amt\" data-kid=\"kbov4eb\">차은우</span></div>\n      <div class=\"divider\" data-kid=\"kprjdn4\"></div>\n      \n      <button class=\"btn\" data-kid=\"kycg0a6\">Get Started</button>\n    </article>\n\n    <!-- Quarterly -->\n    <article class=\"card\" data-kid=\"k67kp4z\">\n      <span class=\"badge\" data-kid=\"kym964e\">Save $1,800</span>\n      <h2 data-kid=\"krgkng1\">Quarterly</h2>\n      <p 